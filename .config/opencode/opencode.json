{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,

  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",

    "edit": "deny",
    "task": "deny",

    "bash": {
      "*": "ask",

      "ls *": "allow",
      "rg *": "allow",
      "rg *--pre*": "deny",
      "rm *": "deny",
      "perl *": "deny",
      "sed *": "deny",
      "ruby *": "deny",
      "node *": "deny",
      "awk *": "deny",

      "git": "ask",
      "git *": "ask",

      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",

      "mvn test": "allow",
      "mvn test *": "allow",
      "npm test": "allow",
      "npm test *": "allow"
    },

    "external_directory": {
      "*": "deny",
      "/home/tyler/projects/*": "allow",
      "/home/tyler/.local/*": "allow",
      "/tmp/nvim.tyler/*": "allow",
      "/tmp/opencode/*": "allow"
    }
  },

  "default_agent": "coworker",

  "agent": {
    "plan": {
      "disable": true
    },

    "build": {
      "disable": true
    },

    "coworker": {
      "mode": "primary",
      "model": "github-copilot/gpt-6.1-sol",
      "reasoningEffort": "medium",
      "description": "Read-only engineering advisor for code investigation, explanations, trade-off analysis, and implementation planning",
      "prompt": "{file:~/.config/opencode/prompts/coworker.txt}",
      "permission": {
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "ls": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "rg *--pre*": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git branch --show-current": "allow",
          "git remote -v": "allow",
          "git tag --list": "allow",
          "git *--output*": "deny",
          "git *--ext-diff*": "deny",
          "git *--textconv*": "deny",
          "file *": "allow",
          "stat *": "allow",
          "wc *": "allow"
        }
      }
    },

    "cobuild": {
      "mode": "primary",
      "model": "github-copilot/gpt-6-luna",
      "reasoningEffort": "xhigh",
      "description": "Pair-programming builder that implements one reviewable method at a time and waits for user approval",
      "prompt": "{file:~/.config/opencode/prompts/cobuild.txt}",
      "steps": 40,
      "permission": {
        "task": "deny",
        "question": "allow",
        "external_directory": {
          "*": "deny"
        },
        "edit": {
          "*": "allow",
          "../*": "deny",
          ".git": "deny",
          ".git/*": "deny",
          "*/.git": "deny",
          "*/.git/*": "deny",
          ".config/opencode/**": "allow",
          "*/.config/opencode/**": "allow"
        },
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "file *": "allow",
          "stat *": "allow",
          "wc *": "allow",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git branch --show-current": "allow",
          "git rev-parse *": "allow",
          "mvn test": "allow",
          "mvn test *": "allow",
          "npm test": "allow",
          "npm test *": "allow",
          "rg *--pre*": "deny",
          "rm *": "deny",
          "perl *": "deny",
          "sed *": "deny",
          "ruby *": "deny",
          "node *": "deny",
          "awk *": "deny",
          "git *--output*": "deny",
          "git *--ext-diff*": "deny",
          "git *--textconv*": "deny",
          "git -C *": "deny",
          "git config *": "deny",
          "git commit": "deny",
          "git commit *": "deny",
          "git push": "deny",
          "git push *": "deny",
          "git reset *": "deny",
          "git restore *": "deny",
          "git checkout *": "deny",
          "git switch *": "deny",
          "git stash *": "deny",
          "git clean *": "deny",
          "git rebase *": "deny",
          "git merge *": "deny",
          "git cherry-pick *": "deny"
        }
      }
    },

    "poc": {
      "mode": "primary",
      "model": "github-copilot/gpt-6-luna",
      "variant": "xhigh",
      "description": "Autonomous proof-of-concept builder that works inside the current repository and commits and pushes a poc/* branch",
      "prompt": "{file:~/.config/opencode/prompts/poc.txt}",
      "permission": {
        "task": "deny",
        "external_directory": {
          "*": "deny"
        },
        "edit": {
          "*": "allow",
          "../*": "deny",
          "*.env": "ask",
          "*.env.*": "ask",
          ".git": "deny",
          ".git/*": "deny",
          "*/.git": "deny",
          "*/.git/*": "deny",
          "opencode.json": "deny",
          "opencode.jsonc": "deny",
          ".opencode/**": "deny",
          "*/.opencode/**": "deny",
          ".config/opencode/**": "deny",
          "*/.config/opencode/**": "deny"
        },
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "file *": "allow",
          "stat *": "allow",
          "wc *": "allow",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git branch --show-current": "allow",
          "git rev-parse --show-toplevel": "allow",
          "git add *": "ask",
          "git commit": "allow",
          "git commit *": "allow",
          "git push": "ask",
          "git push *": "ask",
          "mvn *": "allow",
          "./mvnw *": "allow",
          "npm *": "allow",
          "node *": "ask",
          "npm exec *": "ask",
          "rm *": "ask",
          "git push *": "ask",
          "git push *:*": "deny",
          "git push *--force*": "deny",
          "git push -f*": "deny",
          "git push *-f": "deny",
          "git push *-f *": "deny",
          "git push *+*": "deny",
          "git push *--mirror*": "deny",
          "git push *--delete*": "deny",
          "git push *-d *": "deny",
          "git push *--tags*": "deny",
          "git push *--no-verify*": "deny",
          "git commit *--amend*": "ask",
          "git commit *--no-verify*": "deny",
          "git checkout": "deny",
          "git checkout *": "deny",
          "git switch": "deny",
          "git switch *": "deny",
          "git -C *": "deny",
          "git --git-dir*": "deny",
          "git --work-tree*": "deny",
          "git config *": "deny",
          "git remote add *": "deny",
          "git remote set-url *": "deny",
          "git remote remove *": "deny",
          "git remote rm *": "deny",
          "git remote rename *": "deny",
          "git worktree *": "deny",
          "git submodule *": "deny",
          "git rebase *": "deny",
          "git merge *": "deny",
          "git cherry-pick *": "deny",
          "git reset *": "deny",
          "git clean *": "deny",
          "git branch -d *": "deny",
          "git branch -D *": "deny",
          "git stash *": "deny",
          "git filter-branch *": "deny",
          "git filter-repo *": "deny",
          "git update-ref *": "deny",
          "git *--output*": "deny",
          "git *--ext-diff*": "deny",
          "git *--textconv*": "deny",
          "npm publish*": "deny",
          "npm * -g": "deny",
          "npm * -g *": "deny",
          "npm *--global*": "deny",
          "npm *--location=global*": "deny",
          "npm config *": "deny",
          "npm login*": "deny",
          "npm adduser*": "deny",
          "mvn *deploy*": "deny",
          "mvn *release:*": "deny",
          "./mvnw *deploy*": "deny",
          "./mvnw *release:*": "deny",
          "sudo *": "deny",
          "su *": "deny",
          "chown *": "deny",
          "ssh *": "deny",
          "scp *": "deny",
          "gh repo delete *": "deny",
          "gh pr merge *": "deny",
          "rg *--pre*": "deny",
          "perl *": "deny",
          "ruby *": "deny",
          "sed *": "deny",
          "awk *": "deny"
        }
      }
    }
  }
}
