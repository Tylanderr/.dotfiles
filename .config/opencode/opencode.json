{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,

  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "question": "allow",

    "edit": "deny",
    "task": "deny",

    "bash": {
      "*": "ask",
      "ls *": "allow",
      "git *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "grep *": "allow",
      "mvn *": "allow",
      "rm *": "deny",
      "python3 *": "deny"
    },

    "external_directory": {
      "/home/tyler/projects/*": "allow"
    }
  },

  "default_agent": "coworker",

  "agent": {
    "plan": {
      "disable": true
    },

    "build": {
      "disable": true,
      "permission": {
        "bash": {
          "git *": "allow",
          "git commit *": "ask",
          "python3 *": "allow"
        },
        "edit": "allow"
      }
    },

    "coworker": {
      "mode": "primary",
      "description": "Custom agent to act as a coworker",
      "prompt": "{file:~/.config/opencode/prompts/coworker.txt}",
    }
  }
}

