{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,

  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "question": "allow",

    "edit": "deny",
    "task": "deny",

    "bash": {
      "*": "ask",

      "ls *": "allow",
      "mvn *": "allow",
      "rg *": "allow",
      "rm *": "deny",
      "python3 *": "deny",
      "python *": "deny",
      "perl *": "deny",
      "sed *": "deny",
      "ruby *": "deny",
      "node *": "deny",
      "awk *": "deny",

      "git *": "allow",
      "git commit": "deny",
      "git commit *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "git reset": "deny",
      "git reset *": "deny",
      "git clean": "deny",
      "git clean *": "deny",
      "git checkout": "deny",
      "git checkout *": "deny"
    },

    "external_directory": {
      "/home/tyler/projects/*": "allow",
      "/home/tyler/*": "allow"
    }
  },

  "default_agent": "coworker",

  "agent": {
    "plan": {
      "disable": true
    },

    "build": {
      "disable": false,
      "permission": {
        "edit": {
          "*": "deny",
          "/home/tyler/projects/**": "allow"
        },
        "bash": "allow",
        "task": "allow"
      }
    },

    "coworker": {
      "mode": "primary",
      "model": "github-copilot/gpt-6-luna",
      "reasoningEffort": "xhigh",
      "description": "Custom agent to act as a coworker",
      "prompt": "{file:~/.config/opencode/prompts/coworker.txt}",
    }
  }
}