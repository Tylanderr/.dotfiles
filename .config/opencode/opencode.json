{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "plan",

  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",

    "edit": "deny",
    "task": "deny",

    "bash": {
      "*": "ask",

      "ls *": "allow",
      "rg *": "allow",
      "rg *--pre*": "deny",
      "rm *": "deny",
      "perl *": "deny",
      "sed *": "deny",
      "ruby *": "deny",
      "node *": "deny",
      "awk *": "deny",

      "git": "ask",
      "git *": "ask",

      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",

      "mvn test": "allow",
      "mvn test *": "allow",
      "npm test": "allow",
      "npm test *": "allow"
    },

    "external_directory": {
      "*": "deny",
      "/home/tyler/projects/*": "allow",
      "/home/tyler/.local/*": "allow",
      "/tmp/nvim.tyler/*": "allow",
      "/tmp/opencode/*": "allow"
    }
  },

  "agent": {
    "plan": {
      "model": "github-copilot/gpt-6.1-sol",
      "variant": "medium",
      "permission": {
        "task": "allow"
      }
    },

    "build": {
      "model": "github-copilot/gpt-6-luna",
      "variant": "xhigh",
      "permission": {
        "edit": "allow",
        "task": "allow",
        "bash": {
          "git add": "allow",
          "git add *": "allow",
          "git commit": "allow",
          "git commit *": "allow",
          "git push": "deny",
          "git push *": "deny"
        }
      }
    },

    "coworker": {
      "disable": true,
      "mode": "primary",
      "model": "github-copilot/gpt-6.1-sol",
      "variant": "medium",
      "description": "Read-only engineering advisor for code investigation, explanations, trade-off analysis, and implementation planning",
      "prompt": "{file:~/.config/opencode/prompts/coworker.txt}",
      "permission": {
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "ls": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "rg *--pre*": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git branch --show-current": "allow",
          "git remote -v": "allow",
          "git tag --list": "allow",
          "git *--output*": "deny",
          "git *--ext-diff*": "deny",
          "git *--textconv*": "deny",
          "file *": "allow",
          "stat *": "allow",
          "wc *": "allow"
        }
      }
    },

    "cobuild": {
      "disable": true,
      "mode": "primary",
      "model": "github-copilot/gpt-6-luna",
      "variant": "xhigh",
      "description": "Pair-programming builder that implements one reviewable method at a time and waits for user approval",
      "prompt": "{file:~/.config/opencode/prompts/cobuild.txt}",
      "permission": {
        "task": "deny",
        "question": "deny",
        "edit": {
          "*": "allow",
          "../*": "deny",
          ".git": "deny",
          ".git/*": "deny",
          "*/.git": "deny",
          "*/.git/*": "deny",
        },
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "file *": "allow",
          "stat *": "allow",
          "wc *": "allow",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git branch --show-current": "allow",
          "git rev-parse *": "allow",
          "mvn test": "allow",
          "mvn test *": "allow",
          "mvn -Dtest=* test": "allow",
          "mvn -Dtest=* test *": "allow",
          "npm test": "allow",
          "npm test *": "allow",
          "rg *--pre*": "deny",
          "rm *": "deny",
          "perl *": "deny",
          "sed *": "deny",
          "ruby *": "deny",
          "node *": "deny",
          "awk *": "deny",
          "git *--output*": "deny",
          "git *--ext-diff*": "deny",
          "git *--textconv*": "deny",
          "git -C *": "deny",
          "git config *": "deny",
          "git commit": "deny",
          "git commit *": "deny",
          "git push": "deny",
          "git push *": "deny",
          "git reset *": "deny",
          "git restore *": "deny",
          "git checkout *": "deny",
          "git switch *": "deny",
          "git stash *": "deny",
          "git clean *": "deny",
          "git rebase *": "deny",
          "git merge *": "deny",
          "git cherry-pick *": "deny"
        }
      }
    }
  }
}
