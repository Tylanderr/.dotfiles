{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "git *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "grep *": "allow",
      "mvn *": "allow",
      "rm *": "deny",
      "python *": "deny"
    },
    "edit": {
      "*": "deny"
    },
  },
  "default_agent": "coworker",
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "permission": {
        "bash": {
          "git *": "allow",
          "git commit *": "ask",
          "python *": "allow"
        },
        "edit": "allow",
      }
    },
    "coworker": {
      "mode": "primary",
      "description": "Custom agent to act as a coworker",
      "prompt": "{file:~/.config/opencode/prompts/coworker.txt}"
    }
  }
}
