{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,

  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",

    "edit": "deny",
    "task": "deny",

    "bash": {
      "*": "ask",

      "ls *": "allow",
      "rg *": "allow",
      "rg *--pre*": "deny",
      "rm *": "deny",
      "perl *": "deny",
      "sed *": "deny",
      "ruby *": "deny",
      "node *": "deny",
      "awk *": "deny",

      "git": "ask",
      "git *": "ask",

      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",

      "mvn test": "allow",
      "mvn test *": "allow",
      "npm test": "allow",
      "npm test *": "allow"
    },

    "external_directory": {
      "*": "deny",
      "/home/tyler/projects/*": "allow",
      "/home/tyler/.local/*": "allow",
      "/tmp/nvim.tyler/*": "allow",
      "/tmp/opencode/*": "allow"
    }
  },

  "default_agent": "coworker",

  "agent": {
    "plan": {
      "disable": true
    },

    "build": {
      "disable": false,
      "permission": {
        "edit": {
          "*": "allow",
          "../*": "deny"
        },
        "task": "allow"
      }
    },

    "coworker": {
      "mode": "primary",
      "model": "github-copilot/gpt-6.1-sol",
      "reasoningEffort": "medium",
      "description": "Custom agent to act as a coworker",
      "prompt": "{file:~/.config/opencode/prompts/coworker.txt}",
      "permission": {
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "ls": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "rg *--pre*": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git branch --show-current": "allow",
          "git remote -v": "allow",
          "git tag --list": "allow",
          "git *--output*": "deny",
          "git *--ext-diff*": "deny",
          "git *--textconv*": "deny",
          "file *": "allow",
          "stat *": "allow",
          "wc *": "allow"
        }
      }
    }
  }
}
